//@version=6
indicator("Keltner Channels", "KC", overlay = true, timeframe = "", timeframe_gaps = true)

length = input.int(20, "Length", minval = 1)
multiplier = input.float(2.0, "Multiplier")
source = input.source(close, "Source")
useEma = input.bool(true, "Use Exponential MA")
bandsStyle = input.string("Average True Range", "Bands Style", options = ["Average True Range", "True Range", "Range"])
atrLength = input.int(10, "ATR Length", minval = 1)

ema = ta.ema(source, length)
sma = ta.sma(source, length)
atr = ta.atr(atrLength)
rangeAverage = ta.rma(high - low, length)

basis = useEma ? ema : sma
bandWidth = bandsStyle == "True Range" ? ta.tr(true) : bandsStyle == "Average True Range" ? atr : rangeAverage
upper = basis + bandWidth * multiplier
lower = basis - bandWidth * multiplier

upperPlot = plot(upper, "Upper", #2962FF)
plot(basis, "Basis", #2962FF)
lowerPlot = plot(lower, "Lower", #2962FF)
fill(upperPlot, lowerPlot, color.rgb(33, 150, 243, 95), "Background")

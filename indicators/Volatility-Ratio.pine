indicator("Volatility Ratio", shorttitle="VR", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

length = input.int(14, title="Length", minval=1)
breakoutLevel = input.float(0.5, title="Breakout Level", minval=0, step=0.1)

_highest(length, start) =>
    out = nz(high[start])
    for i = start + 1 to length - 1
        prev = nz(high[i])
        out := out < prev ? prev : out
    out

_lowest(length, start) =>
    out = nz(low[start])
    for i = start + 1 to length - 1
        prev = nz(low[i])
        out := out > prev ? prev : out
    out

max = math.max(_highest(length, 1), close[length + 1])
min = math.min(_lowest(length, 1), close[length + 1])

vr = ta.tr(true) / (max - min)

vrColor = vr >= breakoutLevel ? color.new(#ff9800, 0) : color.new(#3c78d8, 0)

plot(vr, title="VR", color=vrColor)

hline(breakoutLevel, title="Breakout Level", linestyle=hline.style_dotted)

breakoutFillColor = vr >= breakoutLevel ? color.new(#ff9800, 90) : color.new(color.white, 100)
bgcolor(breakoutFillColor)
